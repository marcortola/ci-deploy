#!/bin/sh
#
# ci-deploy local launcher. Copy this file unchanged into a component (bin/ci-deploy-local is the
# convention); the revision check compares it byte for byte with launcher/ci-deploy-local at the
# revision the component's workflows pin.
#
#   bin/ci-deploy-local [launcher options] [--] <kamal arguments>
#
# It runs the same revision, bundle and helpers as CI:
#
# 1. Reads the marcortola/ci-deploy SHA from the top-level workflows of the nearest
#    .github/workflows above the current directory, and stops if they pin more than one.
# 2. Fetches that revision into a cache (CI_DEPLOY_CACHE, default ~/.cache/ci-deploy/<sha>) and
#    installs its locked bundle there. Nothing is installed globally. Ruby 3.3 comes from PATH or,
#    when absent, from the repository's Nix devShell. A failed bootstrap leaves no cache behind.
# 3. Runs bin/ci-deploy local in the current directory with BUNDLE_GEMFILE, RUBYLIB and PATH
#    pointing at that revision, so Kamal hooks reach the same kamal and helpers.
#
# Launcher options are documented in lib/ci_deploy/local.rb and docs/local-launcher.md.
set -eu

repository_url=${CI_DEPLOY_REPOSITORY_URL:-https://github.com/marcortola/ci-deploy.git}
cache_root=${CI_DEPLOY_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/ci-deploy}

die() {
    echo "ci-deploy-local: $*" >&2
    exit 1
}

component=$(pwd)
while [ ! -d "$component/.github/workflows" ]; do
    [ "$component" != "/" ] || die "no .github/workflows in $(pwd) or any parent directory"
    component=$(dirname "$component")
done
workflows="$component/.github/workflows"

refs=$(
    for file in "$workflows"/*.yml "$workflows"/*.yaml; do
        [ -f "$file" ] || continue
        grep -oE "marcortola/ci-deploy(/[A-Za-z0-9_./-]*)?@[^[:space:]\"'#]+" "$file" || true
    done | sed 's/.*@//' | sort -u
)
[ -n "$refs" ] || die "no workflow in $workflows references marcortola/ci-deploy"
count=$(printf '%s\n' "$refs" | wc -l | tr -d ' ')
# shellcheck disable=SC2086 # split the list into one revision per word
[ "$count" -eq 1 ] || die "the workflows in $workflows pin marcortola/ci-deploy to $count different revisions: $(printf '%s ' $refs)"
sha=$refs
case "$sha" in
    *[!0-9a-f]*) die "marcortola/ci-deploy is pinned to '$sha', not a full commit SHA" ;;
esac
[ "${#sha}" -eq 40 ] || die "marcortola/ci-deploy is pinned to '$sha', not a full commit SHA"

cache="$cache_root/$sha"

with_ruby() {
    if command -v ruby >/dev/null 2>&1 && command -v bundle >/dev/null 2>&1 \
        && ruby -e 'exit(RUBY_VERSION.start_with?("3.3.") ? 0 : 1)' >/dev/null 2>&1; then
        "$@"
    elif command -v nix >/dev/null 2>&1; then
        nix --extra-experimental-features 'nix-command flakes' develop "$cache" --command "$@"
    else
        echo "ci-deploy-local: Ruby 3.3 is not on PATH and Nix is not installed" >&2
        return 1
    fi
}

bootstrap() {
    git -C "$cache" init -q || return 1
    git -C "$cache" fetch -q --depth 1 "$repository_url" "$sha" || return 1
    git -C "$cache" -c advice.detachedHead=false checkout -q FETCH_HEAD || return 1
    [ "$(git -C "$cache" rev-parse HEAD)" = "$sha" ] || return 1
    BUNDLE_GEMFILE="$cache/Gemfile" with_ruby bundle config set --local path vendor/bundle >/dev/null || return 1
    BUNDLE_GEMFILE="$cache/Gemfile" with_ruby bundle config set --local frozen true >/dev/null || return 1
    BUNDLE_GEMFILE="$cache/Gemfile" with_ruby bundle install --quiet || return 1
}

if [ ! -f "$cache/.git/ci-deploy-ready" ]; then
    mkdir -p "$cache_root"
    lock="$cache.lock"
    mkdir "$lock" 2>/dev/null || die "another bootstrap of $sha is running, or one was interrupted: remove $lock and retry"
    rm -rf "$cache"
    mkdir -p "$cache"
    echo "ci-deploy-local: preparing marcortola/ci-deploy@$sha in $cache" >&2
    if bootstrap; then
        : > "$cache/.git/ci-deploy-ready"
        rmdir "$lock"
    else
        rm -rf "$cache"
        rmdir "$lock"
        die "could not prepare marcortola/ci-deploy@$sha; nothing was cached"
    fi
fi

BUNDLE_GEMFILE="$cache/Gemfile"
CI_DEPLOY_HOME="$cache"
CI_DEPLOY_HOOKS_LIB="$cache/lib/sh"
RUBYLIB="$cache/lib${RUBYLIB:+:$RUBYLIB}"
PATH="$cache/bin:$PATH"
export BUNDLE_GEMFILE CI_DEPLOY_HOME CI_DEPLOY_HOOKS_LIB RUBYLIB PATH
with_ruby ruby "$cache/bin/ci-deploy" local "$@"
