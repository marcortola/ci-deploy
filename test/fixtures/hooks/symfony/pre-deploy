#!/bin/sh
# Example consumer hook (Symfony): schema and broker changes before any new role boots, from the
# incoming image. The commands, their order and what a failure means stay in the consumer.
set -eu
# shellcheck source=lib/sh/hooks.sh
. "${CI_DEPLOY_HOOKS_LIB:?run through the ci-deploy setup action}/hooks.sh"

if ci_deploy_is_rollback; then
    echo "Rollback detected; schema and broker stay as they are."
    exit 0
fi

ci_deploy_symfony new-image "doctrine:migrations:migrate -n -v"
ci_deploy_symfony new-image "app:messaging:setup"
