#!/bin/sh
# Integration hook: proves a nested hook reaches the same kamal and bundle as the deploy, and runs a
# command from the incoming image through the shared helper.
set -eu
# shellcheck source=lib/sh/hooks.sh
. "${CI_DEPLOY_HOOKS_LIB:?run through the ci-deploy setup action}/hooks.sh"

{
    echo "kamal=$(command -v kamal)"
    echo "kamal_version=$(kamal version)"
    echo "bundle=${BUNDLE_GEMFILE:-}"
    echo "version=$KAMAL_VERSION"
} >> "${IT_HOOK_LOG:?}"
ci_deploy_exec new-image "cat /www/up" >> "$IT_HOOK_LOG"
